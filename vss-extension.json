{
    "manifestVersion": 1,
    "id": "work-item-group-approval",
    "publisher": "JoshKewley",
    "version": "1.0.2",
    "name": "Work Item Approval Button",
    "description": "Add approval buttons to work items. Restrict each to an Azure DevOps team, show/hide by field value, and capture the approver's identity and timestamp. Only the approver or an admin team can reset.",
    "public": true,
    "categories": [
        "Azure Boards"
    ],
    "tags": [
        "work item",
        "release",
        "approval",
        "sign-off",
        "governance",
        "workflow",
        "audit",
        "compliance",
        "change management",
        "process"
    ],
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services.Cloud"
        }
    ],
    "icons": {
        "default": "images/validation-approval.png"
    },
    "scopes": [
        "vso.work_write",
        "vso.project"
    ],
    "content": {
        "details": {
            "path": "marketplace-overview.md"
        }
    },
    "repository": {
        "type": "git",
        "uri": "https://github.com/jkewley/ado-work-item-approval"
    },
    "files": [
        {
            "path": "dist/ApprovalControl",
            "addressable": true,
            "packagePath": "ApprovalControl"
        },
        {
            "path": "dist/assets/fonts/fluent-regular.woff2",
            "addressable": true,
            "packagePath": "assets/fonts/fluent-regular.woff2",
            "contentType": "font/woff2"
        },
        {
            "path": "dist/assets/fonts/fluent-filled.woff2",
            "addressable": true,
            "packagePath": "assets/fonts/fluent-filled.woff2",
            "contentType": "font/woff2"
        },
        {
            "path": "dist/assets/fonts/AzDevMDL2.woff",
            "addressable": true,
            "packagePath": "assets/fonts/AzDevMDL2.woff",
            "contentType": "font/woff"
        },
        {
            "path": "images",
            "addressable": true
        }
    ],
    "contributions": [
        {
            "id": "group-approval-control",
            "type": "ms.vss-work-web.work-item-form-control",
            "description": "Approval button scoped to a named group.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Work Item Approval Button",
                "uri": "ApprovalControl/ApprovalControl.html",
                "height": 32,
                "supportsReadOnly": true,
                "inputs": [
                    {
                        "id": "GroupName",
                        "name": "Group name",
                        "description": "The group this control approves for, e.g. IT, QA, Business. Shown on the button as '<Group name> Approver'.",
                        "type": "string",
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "ApproverField",
                        "name": "Approver field",
                        "description": "Identity field that stores who granted approval. Create one per group in your inherited process, e.g. Custom.ITApprover. Create this field before adding the control.",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "String",
                                "Identity"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "ApprovedOnField",
                        "name": "Approved on field (optional)",
                        "description": "DateTime field that stores when the approval was given, e.g. Custom.ITApprovedOn. Create this field before adding the control.",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "DateTime"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "ApproverTeam",
                        "name": "Approver team (optional)",
                        "description": "Name of the ADO team whose members may approve, e.g. 'IT Approvers'. Leave blank to allow anyone. Must match the team name exactly as shown in Project Settings → Teams.",
                        "type": "string",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "AdminTeam",
                        "name": "Admin team (optional)",
                        "description": "Name of the ADO team whose members may reset anyone's approval. Leave blank to allow only the original approver to reset. Must match the team name exactly as shown in Project Settings → Teams.",
                        "type": "string",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "VisibilityField",
                        "name": "Visibility field (optional)",
                        "description": "Reference name of a field that controls whether this button is shown, e.g. Custom.ReleaseType. Leave blank to always show the button.",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "String",
                                "PlainText",
                                "Integer",
                                "Double",
                                "Boolean",
                                "Guid"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "VisibilityValue",
                        "name": "Visibility value (optional)",
                        "description": "The value that the visibility field must equal for the button to appear, e.g. Emergency. Comparison is case-insensitive.",
                        "type": "string",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    }
                ]
            }
        }
    ]
}